<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<configuration>
    <context>
        <name>local-only</name>
        <desc>Include only the local app origin reached from the ZAP container.</desc>
        <inscope>true</inscope>
        <incregexes>http://host\.docker\.internal:3000.*</incregexes>
        <tech>
            <include>Db</include>
            <include>Language</include>
            <include>Language.JavaScript</include>
            <include>OS</include>
            <include>SCM</include>
            <include>WS</include>
        </tech>
        <urlparser>
            <class>org.zaproxy.zap.model.StandardParameterParser</class>
            <config>{"kvps":";","kvs":"=","struct":[]}</config>
        </urlparser>
        <postparser>
            <class>org.zaproxy.zap.model.StandardParameterParser</class>
            <config>{"kvps":"&amp;","kvs":"=","struct":[]}</config>
        </postparser>
        <authentication>
            <type>0</type>
        </authentication>
        <forceduser>-1</forceduser>
        <session>
            <type>0</type>
        </session>
        <authorization>
            <type>0</type>
            <basic>
                <header/>
                <body/>
                <logic>AND</logic>
                <code>-1</code>
            </basic>
        </authorization>
    </context>
</configuration>
